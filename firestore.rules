rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{profileId} {
      allow read, write: if true;
      
      match /active_phase/{activityId} {
        allow read, delete: if true;
        allow create, update: if !request.resource.data.keys().hasAny(['workoutCategory']) 
                     || request.resource.data.workoutCategory in ['continuous_run', 'intervals', 'strength', 'rest', 'cross_training'];
      }
      
      match /history/{activityId} {
        allow read, delete: if true;
        allow create, update: if !request.resource.data.keys().hasAny(['workoutCategory']) 
                     || request.resource.data.workoutCategory in ['continuous_run', 'intervals', 'strength', 'rest', 'cross_training'];
      }
    }
    
    match /turkeyTrotSubmissions/{document=**} {
      allow read, write: if true;
    }
    
    match /turkeyTrotComments/{document=**} {
      allow read, write: if true;
    }
  }
}